# ── BankOps Backend Configuration ─────────────────────────────
# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file.

# Database
DATABASE_URL=postgresql://postgres:Elias@1995@localhost:5432/bankops

# JWT Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
APP_NAME=BankOps
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
